      "id": "2584c20e-ed8c-4cf4-8a1b-38d9326c6ef5",
      "name": "Merge Results"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(item => item.json);\n\nconst ok = items\n  .filter(x => x.apiOk)\n  .sort((a, b) => b.score - a.score);\n\nconst errors = items.filter(x => !x.apiOk);\n\nconst lines = [];\n\nlines.push(\"📰 HACKER NEWS MORNING BRIEF\");\nlines.push(\"━━━━━━━━━━━━━━━━━━━━\");\nlines.push(\"🔥 HIGH priority: score ≥ 100\");\nlines.push(\"\");\n\nfor (const x of ok) {\n  const priority = x.priority || \"NORMAL\";\n\n  lines.push(\n    `${x.rank}. [${priority}] ${x.title}`\n  );\n\n  lines.push(\n    `   ⭐ ${x.score} points • by ${x.by}`\n  );\n\n  if (x.url) {\n    lines.push(`   🔗 ${x.url}`);\n  }\n\n  lines.push(\"\");\n}\n\nif (errors.length > 0) {\n  lines.push(\"⚠️ API ERRORS\");\n  lines.push(\"━━━━━━━━━━━━━━━━━━━━\");\n\n  for (const e of errors) {\n    lines.push(`• ${e.error || \"Unknown error\"}`);\n  }\n\n  lines.push(\"\");\n}\n\nlines.push(\"━━━━━━━━━━━━━━━━━━━━\");\nlines.push(`📊 Stories: ${ok.length}`);\nlines.push(`⚠️ Errors: ${errors.length}`);\nlines.push(`🕐 Generated: ${new Date().toLocaleString(\"en-IN\")}`);\n\nreturn [\n  {\n    json: {\n      digest: lines.join(\"\\n\"),\n      itemCount: ok.length,\n      errorCount: errors.length\n    }\n  }\n];"
      },
