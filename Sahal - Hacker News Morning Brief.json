      "name": "HN Story Details",
      "retryOnFail": true,
      "waitBetweenTries": 1000,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map((item, index) => {\n  const j = item.json ?? {};\n  const id = j.id ?? j.storyId ?? null;\n  const apiOk = Number.isFinite(Number(j.score)) && id !== null;\n  return { json: {\n    rank: index + 1,\n    id,\n    title: j.title ?? '(untitled)',\n    score: Number(j.score ?? 0),\n    by: j.by ?? 'unknown',\n    url: j.url ?? (id ? `https://news.ycombinator.com/item?id=${id}` : null),\n    apiOk,\n    error: apiOk ? null : (j.error?.message ?? j.message ?? 'Story lookup failed')\n  }};\n});"
      },
